<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <StartupObject>DenoVideoPlayer.Program</StartupObject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DenoVideoPlayer</RootNamespace>
    <AssemblyName>DenoVideoPlayer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Product>Deno Video Player</Product>
    <AssemblyTitle>Deno Video Player</AssemblyTitle>
    <Company>DENO</Company>
    <Copyright>Copyright © DENO 2026</Copyright>
    <Version>0.4.5</Version>
    <FileVersion>0.4.5.0</FileVersion>
    <InformationalVersion>0.4.5</InformationalVersion>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="runtime\mpv\.gitkeep">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="runtime\mpv\mpv.exe">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Include="runtime\ffmpeg\**">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <!-- 사용자 설치용 파일들 — dotnet publish 시 output 폴더에 함께 복사 -->
    <None Include="START_HERE.bat;UNINSTALL.bat;README.md;LICENSE;NOTICE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="tools\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- WPF Window.Icon용 임베디드 리소스 -->
    <Resource Include="icon.ico" />
  </ItemGroup>

  <!-- tests 폴더는 별도 프로젝트(tests/DenoVideoPlayer.Tests) — 메인 csproj가 자동으로 끌어들이지 않게 -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <Resource Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.0.1" />
  </ItemGroup>

</Project>
