<Window x:Class="DenoPlayer.Views.RecentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:DenoPlayer.Helpers"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        Width="340"
        SizeToContent="Manual">

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Border x:Name="Root"
            Background="{StaticResource BrushBgRaised}"
            BorderBrush="{StaticResource BrushBorderStrong}"
            BorderThickness="0,0,1,0"
            Effect="{StaticResource ShadowPanel}"
            MouseEnter="OnPanelEnter"
            MouseLeave="OnPanelLeave">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTx" X="-340"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="14,12"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="최근 재생" Style="{StaticResource TextMono}"/>
                    <TextBlock Style="{StaticResource TextBody}"
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource BrushFgMuted}">
                        <Run Text="{Binding Recents.Count, Mode=OneWay}"/>
                        <Run Text=" 항목"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <ListBox Grid.Row="1"
                     x:Name="RecentListBox"
                     Style="{StaticResource PlaylistList}"
                     ItemsSource="{Binding Recents}"
                     PreviewMouseLeftButtonUp="OnItemClicked">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="탐색기에서 열기" Click="OnRevealInExplorer"/>
                                    <MenuItem Header="파일 경로 복사" Click="OnCopyPath"/>
                                    <Separator/>
                                    <MenuItem Header="이 항목 제거" Click="OnRemoveOne"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <TextBlock Text="{Binding FileName}"
                                       Style="{StaticResource TextBody}"
                                       FontSize="{StaticResource FontSizeSm}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FolderDisplay}"
                                       Style="{StaticResource TextMuted}"
                                       FontSize="{StaticResource FontSizeXs}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Padding="14,8"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
                <Button Style="{StaticResource GhostButton}"
                        Content="모두 비우기"
                        Click="OnClearAll"
                        HorizontalAlignment="Left"/>
            </Border>
        </Grid>
    </Border>
</Window>
