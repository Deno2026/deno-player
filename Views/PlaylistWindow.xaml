<Window x:Class="DenoVideoPlayer.Views.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:DenoVideoPlayer.Helpers"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        Width="320"
        SizeToContent="Manual">

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Border x:Name="Root"
            Background="{StaticResource BrushBgRaised}"
            BorderBrush="{StaticResource BrushBorderStrong}"
            BorderThickness="1,0,0,0"
            Effect="{StaticResource ShadowPanel}"
            MouseEnter="OnPanelEnter"
            MouseLeave="OnPanelLeave">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTx" X="320"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="14,12"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="현재 폴더" Style="{StaticResource TextMono}"/>
                    <TextBlock Text="{Binding FolderDisplay}"
                               Style="{StaticResource TextBody}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <ListBox Grid.Row="1"
                     x:Name="PlaylistListBox"
                     Style="{StaticResource PlaylistList}"
                     ItemsSource="{Binding Playlist}"
                     SelectedItem="{Binding CurrentMedia, Mode=OneWay}"
                     PreviewMouseLeftButtonUp="OnItemClicked"
                     MouseDoubleClick="OnItemDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="탐색기에서 열기" Click="OnRevealInExplorer"/>
                                    <MenuItem Header="파일 경로 복사" Click="OnCopyPath"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding FileName}"
                                           Style="{StaticResource TextBody}"
                                           FontSize="{StaticResource FontSizeSm}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource TextMono}"
                                           Text="실패"
                                           Foreground="{StaticResource BrushDanger}"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DurationDisplay}"
                                       Style="{StaticResource TextMono}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Padding="14,8"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
                <TextBlock Style="{StaticResource TextMono}">
                    <Run Text="{Binding Playlist.Count, Mode=OneWay}"/>
                    <Run Text=" 항목"/>
                </TextBlock>
            </Border>
        </Grid>
    </Border>
</Window>
