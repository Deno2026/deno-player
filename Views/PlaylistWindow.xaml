<Window x:Class="DenoVideoPlayer.Views.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:DenoVideoPlayer.Helpers"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        Width="320"
        SizeToContent="Manual">

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolVis"/>
        <h:MediaKindIconGeometryConverter x:Key="KindIcon"/>
    </Window.Resources>

    <Border x:Name="Root"
            Background="{StaticResource BrushBgRaised}"
            BorderBrush="{StaticResource BrushBorderStrong}"
            BorderThickness="1,0,0,0"
            Effect="{StaticResource ShadowPanel}"
            MouseEnter="OnPanelEnter"
            MouseLeave="OnPanelLeave">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTx" X="320"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="14,12"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource PlaylistCurrentFolder}" Style="{StaticResource TextMono}"/>
                    <TextBlock Text="{Binding FolderDisplay}"
                               Style="{StaticResource TextBody}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <ListBox Grid.Row="1"
                     x:Name="PlaylistListBox"
                     Style="{StaticResource PlaylistList}"
                     ItemsSource="{Binding Playlist}"
                     SelectedItem="{Binding CurrentMedia, Mode=OneWay}"
                     PreviewMouseLeftButtonDown="OnItemPressed"
                     PreviewMouseLeftButtonUp="OnItemClicked">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource OpenInExplorer}" Click="OnRevealInExplorer"/>
                                    <MenuItem Header="{DynamicResource CopyFilePath}" Click="OnCopyPath"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Border Grid.Column="0"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Background="{StaticResource BrushBgElevated}"
                                    BorderBrush="{StaticResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    SnapsToDevicePixels="True">
                                <Path Data="{Binding Kind, Converter={StaticResource KindIcon}}"
                                      Fill="{StaticResource BrushAccent}"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding FileName}"
                                           Style="{StaticResource TextBody}"
                                           FontSize="{StaticResource FontSizeSm}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource TextMono}"
                                           Text="{DynamicResource Failure}"
                                           Foreground="{StaticResource BrushDanger}"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DurationDisplay}"
                                       Style="{StaticResource TextMono}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Padding="14,8"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
                <TextBlock Style="{StaticResource TextMono}">
                    <Run Text="{Binding Playlist.Count, Mode=OneWay}"/>
                    <Run Text="{DynamicResource ItemSuffix}"/>
                </TextBlock>
            </Border>
        </Grid>
    </Border>
</Window>
