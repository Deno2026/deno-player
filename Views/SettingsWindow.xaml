<Window x:Class="DenoPlayer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DenoPlayer.ViewModels"
        Title="환경설정 — 연결 프로그램 등록"
        Width="520" Height="600"
        MinWidth="440" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBgBase}"
        Foreground="{StaticResource BrushFgPrimary}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="ExtCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrushFgPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="Margin" Value="0,2,12,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="GroupAllCheckBox" TargetType="CheckBox" BasedOn="{StaticResource ExtCheckBox}">
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="연결 프로그램 등록"
                       FontFamily="{StaticResource FontUi}"
                       FontSize="{StaticResource FontSizeXl}"
                       Foreground="{StaticResource BrushFgPrimary}"/>
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource TextSecondary}"
                       TextWrapping="Wrap"
                       Text="체크한 확장자를 Deno Player의 '연결 프로그램' 후보로 등록합니다. 기본 앱 자동 지정은 Windows 정책상 불가하므로, 확인 후 '기본 앱 설정 열기'를 눌러 Windows 설정에서 한 번에 지정하세요."/>
        </StackPanel>

        <Separator Grid.Row="1"
                   Background="{StaticResource BrushBorderSubtle}"
                   Margin="0,8,0,12"/>

        <!-- 카테고리 리스트 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BrushBgRaised}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="16,14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox Style="{StaticResource GroupAllCheckBox}"
                                          IsChecked="{Binding AllSelected, Mode=TwoWay}"
                                          Content="{Binding Title}"/>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource ExtCheckBox}"
                                                      IsChecked="{Binding Selected, Mode=TwoWay}"
                                                      Content="{Binding Extension}"
                                                      MinWidth="70"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 액션 버튼 -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Style="{StaticResource ActionButton}"
                    Content="취소"
                    IsCancel="True"
                    Click="OnCancel"/>
            <Button Style="{StaticResource ActionButton}"
                    Content="확인"
                    IsDefault="True"
                    Foreground="{StaticResource BrushAccent}"
                    Click="OnConfirm"/>
        </StackPanel>
    </Grid>
</Window>
