<Window x:Class="DenoVideoPlayer.Views.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="DialogButtonBase" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSm}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgElevated}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentTint}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BrushFgMuted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource DialogButtonBase}">
            <Setter Property="Background" Value="{StaticResource BrushTransparent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushFgPrimary}"/>
        </Style>

        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButtonBase}">
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushFgInverse}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BrushBgRaised}"
            BorderBrush="{StaticResource BrushChromeOutline}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Effect="{StaticResource ShadowPanel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource BrushBgElevated}"
                    BorderBrush="{StaticResource BrushChromeOutline}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    Padding="18,14"
                    MouseLeftButtonDown="OnDragHeader">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="&#xE895;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{StaticResource BrushAccent}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource TextBody}"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Style="{StaticResource TextSecondary}"
                       Foreground="{StaticResource BrushFgPrimary}"
                       FontSize="{StaticResource FontSizeMd}"
                       LineHeight="21"
                       TextWrapping="Wrap"
                       Margin="18,16,18,18"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="18,0,18,18">
                <Button x:Name="CancelButton"
                        Style="{StaticResource DialogSecondaryButton}"
                        IsCancel="True"
                        Click="OnCancelClick"
                        Margin="0,0,8,0"/>
                <Button x:Name="UpdateButton"
                        Style="{StaticResource DialogPrimaryButton}"
                        IsDefault="True"
                        Click="OnUpdateClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
