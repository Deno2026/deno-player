<Window x:Class="DenoVideoPlayer.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        Opacity="0">
    <Border x:Name="ToastBox"
            Background="{StaticResource BrushBgRaised}"
            BorderBrush="{StaticResource BrushAccent}"
            BorderThickness="1"
            CornerRadius="3"
            Padding="14,8"
            Effect="{StaticResource ShadowPanel}">
        <TextBlock x:Name="ToastText"
                   Style="{StaticResource TextBody}"
                   FontSize="{StaticResource FontSizeSm}"
                   MaxWidth="700"
                   TextTrimming="CharacterEllipsis"/>
    </Border>
</Window>
