<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- ============================================================
         DENO Design Tokens
         단일 소스. 색/간격/모서리/시간 등 디자인 결정은 모두 여기.
         로직 코드/뷰코드에서 하드코딩 금지.
         ============================================================ -->

    <!-- ▣ Surface (배경 단계) -->
    <Color x:Key="ColorBgBase">#FF0B0E0C</Color>
    <Color x:Key="ColorBgRaised">#FF11160F</Color>
    <Color x:Key="ColorBgElevated">#FF161D14</Color>
    <Color x:Key="ColorBgOverlay">#EE12180F</Color>
    <Color x:Key="ColorBgScrim">#A6000000</Color>

    <!-- ▣ Border -->
    <Color x:Key="ColorBorderSubtle">#FF1E281C</Color>
    <Color x:Key="ColorBorderStrong">#FF2A3826</Color>

    <!-- ▣ Foreground (글자) -->
    <Color x:Key="ColorFgPrimary">#FFE6EDE3</Color>
    <Color x:Key="ColorFgSecondary">#FF9BA89A</Color>
    <Color x:Key="ColorFgMuted">#FF5E6A5C</Color>
    <Color x:Key="ColorFgInverse">#FF0B0E0C</Color>

    <!-- ▣ DENO accent green — 활성/선택/Ready/Focus 전용 -->
    <Color x:Key="ColorAccent">#FF57E389</Color>
    <Color x:Key="ColorAccentSoft">#FF2E7D44</Color>
    <Color x:Key="ColorAccentDim">#3357E389</Color>
    <Color x:Key="ColorAccentTint">#1A57E389</Color>

    <!-- ▣ State -->
    <Color x:Key="ColorDanger">#FFFF6B6B</Color>
    <Color x:Key="ColorWarn">#FFFFC857</Color>

    <!-- ▣ Brushes -->
    <SolidColorBrush x:Key="BrushBgBase" Color="{StaticResource ColorBgBase}"/>
    <SolidColorBrush x:Key="BrushBgRaised" Color="{StaticResource ColorBgRaised}"/>
    <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColorBgElevated}"/>
    <SolidColorBrush x:Key="BrushBgOverlay" Color="{StaticResource ColorBgOverlay}"/>
    <SolidColorBrush x:Key="BrushBgScrim" Color="{StaticResource ColorBgScrim}"/>

    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}"/>
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}"/>

    <SolidColorBrush x:Key="BrushFgPrimary" Color="{StaticResource ColorFgPrimary}"/>
    <SolidColorBrush x:Key="BrushFgSecondary" Color="{StaticResource ColorFgSecondary}"/>
    <SolidColorBrush x:Key="BrushFgMuted" Color="{StaticResource ColorFgMuted}"/>
    <SolidColorBrush x:Key="BrushFgInverse" Color="{StaticResource ColorFgInverse}"/>

    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}"/>
    <SolidColorBrush x:Key="BrushAccentDim" Color="{StaticResource ColorAccentDim}"/>
    <SolidColorBrush x:Key="BrushAccentTint" Color="{StaticResource ColorAccentTint}"/>

    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushWarn" Color="{StaticResource ColorWarn}"/>

    <SolidColorBrush x:Key="BrushTransparent" Color="#00000000"/>

    <!-- ▣ Radius -->
    <CornerRadius x:Key="RadiusSm">3</CornerRadius>
    <CornerRadius x:Key="RadiusMd">5</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <sys:Double x:Key="RadiusValueSm">3</sys:Double>
    <sys:Double x:Key="RadiusValueMd">5</sys:Double>
    <sys:Double x:Key="RadiusValueLg">8</sys:Double>

    <!-- ▣ Spacing -->
    <Thickness x:Key="SpaceXs">4</Thickness>
    <Thickness x:Key="SpaceSm">8</Thickness>
    <Thickness x:Key="SpaceMd">12</Thickness>
    <Thickness x:Key="SpaceLg">16</Thickness>
    <Thickness x:Key="SpaceXl">24</Thickness>

    <!-- ▣ Typography -->
    <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI, Malgun Gothic, sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, monospace</FontFamily>
    <sys:Double x:Key="FontSizeXs">11</sys:Double>
    <sys:Double x:Key="FontSizeSm">12</sys:Double>
    <sys:Double x:Key="FontSizeMd">13</sys:Double>
    <sys:Double x:Key="FontSizeLg">15</sys:Double>
    <sys:Double x:Key="FontSizeXl">18</sys:Double>

    <!-- ▣ Control sizing -->
    <sys:Double x:Key="ControlBarHeight">44</sys:Double>
    <sys:Double x:Key="ControlButtonSize">32</sys:Double>
    <sys:Double x:Key="SeekBarHeight">4</sys:Double>
    <sys:Double x:Key="SeekBarHoverHeight">6</sys:Double>
    <sys:Double x:Key="PlaylistDefaultWidth">320</sys:Double>
    <sys:Double x:Key="PlaylistMaxRatio">0.36</sys:Double>
    <sys:Double x:Key="PlaylistHotZoneWidth">24</sys:Double>

    <!-- ▣ Timing (ms) -->
    <sys:Double x:Key="DurationFast">120</sys:Double>
    <sys:Double x:Key="DurationMed">180</sys:Double>
    <sys:Double x:Key="DurationSlow">240</sys:Double>
    <sys:Double x:Key="ControlAutoHideMs">2500</sys:Double>
    <sys:Double x:Key="PlaylistAutoHideMs">1000</sys:Double>

    <!-- ▣ Shadow / Glow (subtle, no SaaS soft cards) -->
    <DropShadowEffect x:Key="ShadowPanel" BlurRadius="20" ShadowDepth="0" Opacity="0.55" Color="#FF000000"/>
    <DropShadowEffect x:Key="ShadowControlBar" BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="#FF000000"/>

    <!-- ============================================================
         Reusable styles (얇은 셸; 화려한 SaaS 카드 금지)
         ============================================================ -->

    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushFgPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="TextSecondary" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="Foreground" Value="{StaticResource BrushFgSecondary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
    </Style>

    <Style x:Key="TextMuted" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="Foreground" Value="{StaticResource BrushFgMuted}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
    </Style>

    <Style x:Key="TextMono" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushFgSecondary}"/>
    </Style>

    <!-- 아이콘 버튼 (transport / window). IsHitTestVisibleInChrome=True:
         WindowChrome CaptionHeight=36 영역 안에 있어도 click 받음. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Background" Value="{StaticResource BrushTransparent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushTransparent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource BrushFgPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Width" Value="{StaticResource ControlButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource ControlButtonSize}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- 핵심: 버튼이 focus를 잡지 않게. 잡으면 Space가 Play/Pause 대신 그 버튼을 클릭함 -->
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgElevated}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentTint}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushFgMuted}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
    </Style>

    <!-- 텍스트형 버튼 (간단한 secondary action) — IconButton 상속이라 Focusable=False도 상속됨.
         단 Settings dialog의 OK/Cancel처럼 IsDefault/IsCancel을 받을 버튼은 명시적으로 Focusable=True로 덮어씀. -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- ============================================================
         Slider — transport seek/volume 공용
         ============================================================ -->
    <!-- 미재생 영역(우측) — 어둠. IsHitTestVisible=False: 클릭은 Slider가 받아서
         IsMoveToPointEnabled으로 thumb을 그 위치로 점프시키게 한다 (안 그러면
         RepeatButton이 클릭을 가로채서 LargeChange만 발생). -->
    <Style x:Key="SliderRepeatIncrease" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource BrushBorderStrong}" CornerRadius="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 재생된 영역(좌측) — DENO green. -->
    <Style x:Key="SliderRepeatDecrease" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SeekThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- Grid Background=Transparent: hit-test 영역을 thumb 전체로 확보.
                         (Background null이면 빈 픽셀은 hit 안 받아 드래그 실패) -->
                    <Grid Background="Transparent">
                        <!-- Halo는 시각 효과만 — mouse는 안 가로챔 -->
                        <Ellipse x:Name="Halo"
                                 Fill="{StaticResource BrushAccent}"
                                 Opacity="0"
                                 IsHitTestVisible="False"/>
                        <!-- 평소에도 보이는 원형 indicator -->
                        <Ellipse x:Name="Dot"
                                 Width="12" Height="12"
                                 Fill="{StaticResource BrushAccent}"
                                 Stroke="{StaticResource BrushBgBase}"
                                 StrokeThickness="2"
                                 IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Slider}}, Path=IsMouseOver}" Value="True">
                            <Setter TargetName="Dot" Property="Width" Value="14"/>
                            <Setter TargetName="Dot" Property="Height" Value="14"/>
                        </DataTrigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Dot" Property="Width" Value="14"/>
                            <Setter TargetName="Dot" Property="Height" Value="14"/>
                            <Setter TargetName="Halo" Property="Opacity" Value="0.25"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SeekSlider" TargetType="Slider">
        <Setter Property="Focusable" Value="False"/>
        <!-- IsMoveToPointEnabled=False — Slider 자체가 click 처리 안 함. 우리 OnSeekDown/Move/Up이
             mouse capture로 직접 1:1 mapping. (True면 Slider 내부 RepeatButton/Thumb가 mouse
             capture를 먼저 가져가 우리 PreviewMouseMove가 fire 안 됨.) -->
        <Setter Property="IsMoveToPointEnabled" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <!-- Grid가 thumb 전체 hit-test 영역. Transparent 배경으로 위/아래 여백도 hit. -->
                    <Grid Background="Transparent" VerticalAlignment="Stretch" MinHeight="22">
                        <!-- Track의 두 RepeatButton이 played(green)/remaining(dark) 영역을 직접 그림 -->
                        <Track x:Name="PART_Track" Height="6" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeatDecrease}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeatIncrease}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SeekThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VolumeSlider" TargetType="Slider" BasedOn="{StaticResource SeekSlider}">
        <Setter Property="Width" Value="90"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
    </Style>

    <!-- ============================================================
         ListBox / ListBoxItem — playlist
         ============================================================ -->
    <Style x:Key="PlaylistItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushFgPrimary}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="ActiveBar"
                                    Width="2"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource BrushAccent}"
                                    Opacity="0"/>
                            <ContentPresenter Margin="6,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgElevated}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentTint}"/>
                            <Setter TargetName="ActiveBar" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlaylistList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PlaylistItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <!-- IsVirtualizing=False — owned child window가 처음 show될 때 viewport 0인 상태로
             items realize 안 되는 케이스 발견 (panel 떴는데 contents 빈 검은 사각형). -->
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False"/>
        <!-- ListBox가 ↑↓ 키를 가로채면 Window의 볼륨 단축키가 안 먹음 -->
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="None"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- ============================================================
         ScrollBar — 어둡고 얇음
         ============================================================ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
    </Style>

</ResourceDictionary>
