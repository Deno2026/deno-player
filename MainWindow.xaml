<Window x:Class="DenoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:h="clr-namespace:DenoPlayer.Helpers"
        xmlns:vm="clr-namespace:DenoPlayer.ViewModels"
        Title="Deno Player"
        Icon="pack://application:,,,/icon.ico"
        MinWidth="640" MinHeight="380"
        Width="1280" Height="760"
        Background="{StaticResource BrushBgBase}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        Focusable="True"
        ResizeMode="CanResize"
        MouseDoubleClick="OnRootDoubleClick"
        FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolVis"/>
        <h:BoolToVisibilityConverter x:Key="BoolVisHidden" WhenFalse="Hidden"/>
        <h:BoolToVisibilityConverter x:Key="BoolVisInverse" Invert="True"/>
        <h:PlayPauseIconConverter x:Key="PlayIcon"/>
        <h:MuteIconConverter x:Key="MuteIcon"/>
        <h:FullscreenIconConverter x:Key="FsIcon"/>
        <h:StateToVisibilityConverter x:Key="ShowOnNoFile" Show="NoFile,Dragging"/>
        <h:StateToVisibilityConverter x:Key="ShowOnFailed" Show="Failed"/>
        <h:StateToVisibilityConverter x:Key="ShowOnLoading" Show="Loading"/>
        <h:StateToVisibilityConverter x:Key="ShowOnDragging" Show="Dragging"/>
        <h:StateToVisibilityConverter x:Key="ShowVideoHost"
                                       Show="Playing,Paused,Ready,Loading"
                                       Otherwise="Hidden"/>
        <h:BoolToVisibilityConverter x:Key="BoolVisHiddenAudio" WhenFalse="Hidden"/>

        <Style x:Key="PinButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlwaysOnTop}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlaylistToggleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaylistOpen}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RepeatToggleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRepeatActive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 각 모드 mutex 버튼 — 현재 mode면 accent green, 아니면 mute color -->
        <Style x:Key="RepeatNoneButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRepeatNone}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RepeatAllButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRepeatAll}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RepeatOneButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRepeatOne}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShuffleToggleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Shuffle}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <!-- CaptionHeight=0: OS NC 처리 없음. 더블클릭이 어디서든 WPF 핸들러로 옴.
             가장자리 ResizeBorderThickness만 OS native. -->
        <shell:WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <!-- Space는 hold(꾹 누르면 2x) 처리를 직접 해야 해서 KeyBinding 대신 KeyDown/KeyUp 핸들러로. -->
        <!-- <KeyBinding Key="Space"    Command="{Binding PlayPauseCommand}"/> -->

        <KeyBinding Key="M"        Command="{Binding MuteCommand}"/>
        <KeyBinding Key="F"        Command="{Binding FullscreenCommand}"/>
        <KeyBinding Key="F11"      Command="{Binding FullscreenCommand}"/>
        <KeyBinding Key="Enter"    Modifiers="Alt" Command="{Binding FullscreenCommand}"/>
        <!-- Enter 단독 (메인 키보드 / NumPad Enter 둘 다 잡힘) → 완전 풀스크린 -->
        <KeyBinding Key="Enter"    Command="{Binding FullscreenCommand}"/>
        <KeyBinding Key="Return"   Command="{Binding FullscreenCommand}"/>
        <KeyBinding Key="Escape"   Command="{Binding ExitFullscreenCommand}"/>
        <KeyBinding Key="Left"     Command="{Binding Seek5BackwardCommand}"/>
        <KeyBinding Key="Right"    Command="{Binding Seek5ForwardCommand}"/>
        <KeyBinding Key="Left"     Modifiers="Shift" Command="{Binding Seek30BackwardCommand}"/>
        <KeyBinding Key="Right"    Modifiers="Shift" Command="{Binding Seek30ForwardCommand}"/>
        <KeyBinding Key="Up"       Command="{Binding VolumeUpCommand}"/>
        <KeyBinding Key="Down"     Command="{Binding VolumeDownCommand}"/>
        <KeyBinding Key="PageUp"   Command="{Binding PrevCommand}"/>
        <KeyBinding Key="PageDown" Command="{Binding NextCommand}"/>
        <!-- Ctrl+←/→ — 동영상 일반적 관습 (이전/다음 파일) -->
        <KeyBinding Key="Left"     Modifiers="Control" Command="{Binding PrevCommand}"/>
        <KeyBinding Key="Right"    Modifiers="Control" Command="{Binding NextCommand}"/>
        <KeyBinding Key="OemPeriod" Modifiers="Shift" Command="{Binding IncreaseSpeedCommand}"/>
        <KeyBinding Key="OemComma"  Modifiers="Shift" Command="{Binding DecreaseSpeedCommand}"/>
        <KeyBinding Key="OemPeriod" Command="{Binding FrameStepCommand}"/>
        <KeyBinding Key="OemComma"  Command="{Binding FrameBackCommand}"/>
        <KeyBinding Key="O"        Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S"        Modifiers="Control" Command="{Binding ScreenshotCommand}"/>
        <KeyBinding Key="T"        Modifiers="Control" Command="{Binding AlwaysOnTopCommand}"/>
        <KeyBinding Key="P"        Command="{Binding TogglePlaylistCommand}"/>
        <KeyBinding Key="L"        Modifiers="Control" Command="{Binding TogglePlaylistCommand}"/>
        <!-- 자막/오디오 트랙 사이클 — mpv가 트랙 메타로 cycle. UI에 트랙 list까지 안 띄움(가벼움) -->
        <KeyBinding Key="V"        Command="{Binding CycleSubtitleCommand}"/>
        <KeyBinding Key="V"        Modifiers="Shift" Command="{Binding ToggleSubtitleVisibilityCommand}"/>
        <KeyBinding Key="J"        Modifiers="Control" Command="{Binding CycleAudioCommand}"/>
        <!-- 자르기 (ffmpeg stream copy, 무손실) -->
        <KeyBinding Key="I"        Command="{Binding SetTrimInCommand}"/>
        <KeyBinding Key="O"        Command="{Binding SetTrimOutCommand}"/>
        <KeyBinding Key="X"        Command="{Binding ClearTrimCommand}"/>
        <KeyBinding Key="E"        Modifiers="Control" Command="{Binding ExecuteTrimCommand}"/>
    </Window.InputBindings>

    <Grid x:Name="Root" Focusable="True" FocusVisualStyle="{x:Null}"
          MouseMove="OnRootMouseMove"
          MouseLeave="OnRootMouseLeave"
          PreviewMouseDown="OnRootPreviewMouseDown"
          MouseWheel="OnRootMouseWheel"
          Background="{StaticResource BrushBgBase}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- TopBar -->
            <RowDefinition Height="*"/>      <!-- Video + Playlist -->
            <RowDefinition Height="Auto"/>   <!-- BottomBar -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             TOP BAR — 직접 hit-test 가능한 영역(WindowChrome.CaptionHeight=0).
             좌측 빈 영역은 드래그 핸들(코드비하인드).
             ============================================================ -->
        <Border x:Name="TopBar"
                Grid.Row="0"
                Height="36"
                Background="{StaticResource BrushBgRaised}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTopBarMouseDown"
                MouseMove="OnTopBarMouseMove"
                MouseLeftButtonUp="OnTopBarMouseUp">
            <DockPanel LastChildFill="True">
                <!-- 우: 기능 + 창 컨트롤 (Dock=Right가 우선 측정되어 자기 크기 확보) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- 업데이트 button — 새 버전 발견 시만 visible, accent green. opt-in pull. -->
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE896;"
                            Foreground="{StaticResource BrushAccent}"
                            Command="{Binding ApplyUpdateCommand}"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolVis}}"
                            ToolTipService.InitialShowDelay="0"
                            ToolTipService.ShowDuration="4000">
                        <Button.ToolTip>
                            <ToolTip Content="{Binding UpdateTooltip}"/>
                        </Button.ToolTip>
                    </Button>
                    <Button Style="{StaticResource PlaylistToggleButton}"
                            Content="&#xE8FD;"
                            ToolTip="재생목록 (P)"
                            Command="{Binding TogglePlaylistCommand}"/>
                    <Button Style="{StaticResource PinButton}"
                            Content="&#xE840;"
                            ToolTip="항상 위 (Ctrl+T)"
                            Command="{Binding AlwaysOnTopCommand}"/>
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE722;"
                            ToolTip="스크린샷 (Ctrl+S)"
                            Command="{Binding ScreenshotCommand}"/>
                    <!-- 가위 버튼 — 평소엔 ✂ (편집 모드 진입), 편집 모드일 땐 ✓ (저장 실행).
                         아이콘 자체가 동작 의미를 알려줌. -->
                    <Button Command="{Binding ToggleTrimModeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="&#xE8C6;"/>
                                <Setter Property="ToolTip" Value="자르기 편집 — 핸들 드래그로 IN/OUT 조정"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTrimMode}" Value="True">
                                        <Setter Property="Content" Value="&#xE73E;"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                        <Setter Property="ToolTip" Value="✓ 저장 — 선택 구간 자르기 실행 (Ctrl+E)"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- 편집 모드 취소 X — 편집 모드일 때만 visible -->
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE711;"
                            ToolTip="✕ 취소 — 편집 모드 종료 (Esc)"
                            Command="{Binding CancelTrimModeCommand}"
                            Visibility="{Binding IsTrimMode, Converter={StaticResource BoolVis}}"/>
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE838;"
                            ToolTip="폴더 열기"
                            Command="{Binding OpenFolderCommand}"/>
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE8E5;"
                            ToolTip="파일 열기 (Ctrl+O)"
                            Command="{Binding OpenCommand}"/>
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE713;"
                            ToolTip="환경설정 — 연결 프로그램 등록"
                            Click="OnSettingsClicked"/>
                    <Border Width="1" Height="16" Background="{StaticResource BrushBorderStrong}" Margin="6,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="최소화" Click="OnMinimize"/>
                    <Button x:Name="MaxRestoreBtn" Style="{StaticResource IconButton}"
                            Content="&#xE922;" ToolTip="최대화/복원" Click="OnMaxRestore"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="닫기" Click="OnClose"/>
                </StackPanel>

                <!-- 좌: 파일명 (남은 영역 fill).
                     드래그/더블클릭은 WindowChrome CaptionHeight=36이 OS-native로 처리.
                     이 Border 자체는 hit-test invisible해서 OS 캡션 처리에 안 끼어듦. -->
                <Border Background="Transparent">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="14,0">
                        <Ellipse Width="6" Height="6"
                                 Fill="{StaticResource BrushAccent}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"
                                 Visibility="{Binding HasMedia, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="Deno Player"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{StaticResource BrushFgMuted}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Visibility="{Binding HasMedia, Converter={StaticResource BoolVisInverse}}"/>
                        <TextBlock Text="{Binding FileNameDisplay, FallbackValue=''}"
                                   Style="{StaticResource TextBody}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="800"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ============================================================
             메인 영역: 영상이 전체를 차지. 재생목록은 별도 owned window로 hover 슬라이드.
             좌/우 가장자리에 얇은 hint strip — 사용자가 hover 영역 인지하게.
             ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>   <!-- 좌측 hint (최근 — 상반부) -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3"/>   <!-- 우측 hint (재생목록 — 전체) -->
            </Grid.ColumnDefinitions>

            <!-- 좌측 hint: 상반부만 보이는 그라디언트 (호버 가능 영역 안내) -->
            <Border Grid.Column="0" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource ColorAccent}" Offset="0"/>
                        <GradientStop Color="{StaticResource ColorAccent}" Offset="0.40"/>
                        <GradientStop Color="#0057E389" Offset="0.55"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Opacity>0.32</Border.Opacity>
            </Border>

            <!-- 우측 hint: 전체 (BottomBar 위까지). 약하게 표시. -->
            <Border Grid.Column="2"
                    Background="{StaticResource BrushAccent}"
                    Opacity="0.22"
                    IsHitTestVisible="False"/>

            <!-- 영상 호스트 + 오버레이들 -->
            <Grid Grid.Column="1" ClipToBounds="True">
                <!-- 영상 — 비디오/이미지일 때만 Visible. 오디오/NoFile/Failed일 땐 Hidden -->
                <Border x:Name="VideoHostContainer"
                        Background="#FF050705"
                        Focusable="False"
                        Visibility="{Binding IsVideoSurfaceVisible, Converter={StaticResource BoolVisHiddenAudio}}">
                    <ContentControl x:Name="VideoHostSlot" Focusable="False"/>
                </Border>

                <!-- 오디오 재생 중 — 음표 아이콘 + 통통 튀는 애니메이션 -->
                <Grid Visibility="{Binding IsAudioPlayback, Converter={StaticResource BoolVisHiddenAudio}}"
                      Background="{StaticResource BrushBgBase}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="180" Height="180" HorizontalAlignment="Center">
                            <Grid>
                                <TextBlock Text="&#xE8D6;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="140"
                                           Foreground="{StaticResource BrushAccent}"
                                           Opacity="0.85"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="AudioBounce" Y="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="오디오 재생 중"
                                   Style="{StaticResource TextMono}"
                                   Foreground="{StaticResource BrushFgMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"/>
                    </StackPanel>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetName="AudioBounce"
                                                     Storyboard.TargetProperty="Y"
                                                     From="0" To="-22"
                                                     Duration="0:0:0.55">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                </Grid>

                <!-- NoFile / Dragging — 영상 hidden일 때만 표시되는 카드 -->
                <Grid Visibility="{Binding State, Converter={StaticResource ShowOnNoFile}}"
                      Background="{StaticResource BrushBgBase}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <Border BorderBrush="{StaticResource BrushBorderStrong}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="40,28"
                                Background="{StaticResource BrushBgRaised}">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="6" Height="6" CornerRadius="3"
                                        Background="{StaticResource BrushAccent}"
                                        Margin="0,0,0,14" HorizontalAlignment="Center"/>
                                <TextBlock Text="DENO PLAYER"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushFgMuted}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,18"/>
                                <TextBlock Text="미디어를 끌어다 놓으세요"
                                           Style="{StaticResource TextBody}"
                                           FontSize="{StaticResource FontSizeLg}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="또는 Ctrl+O / 더블클릭으로 열기"
                                           Style="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,18"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button Content="파일 열기"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding OpenCommand}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="폴더 열기"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding OpenFolderCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0"
                                   Style="{StaticResource TextMono}"
                                   Text=".mp4 .mkv .mov .webm  ·  .mp3 .flac .wav  ·  .png .jpg .gif"/>
                    </StackPanel>

                    <!-- Drop highlight -->
                    <Border Visibility="{Binding State, Converter={StaticResource ShowOnDragging}}"
                            BorderBrush="{StaticResource BrushAccent}"
                            BorderThickness="2"
                            Background="#1457E389"
                            IsHitTestVisible="False"/>
                </Grid>

                <!-- Failed -->
                <Grid Visibility="{Binding State, Converter={StaticResource ShowOnFailed}}"
                      Background="{StaticResource BrushBgBase}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
                        <TextBlock Text="재생할 수 없습니다"
                                   Style="{StaticResource TextBody}"
                                   FontSize="{StaticResource FontSizeLg}"
                                   Foreground="{StaticResource BrushDanger}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource TextMuted}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,18"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="다른 파일 열기"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Content="다음 파일" Style="{StaticResource GhostButton}"
                                    Command="{Binding NextCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Loading: 영상 위 살짝 덮음. mpv가 빠르게 첫 frame 그리므로 짧게 -->
                <Grid Visibility="{Binding State, Converter={StaticResource ShowOnLoading}}"
                      Background="#AA0B0E0C"
                      IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="40" Height="2" Background="{StaticResource BrushBorderStrong}" Margin="0,0,0,10">
                            <Border Width="14" Height="2"
                                    Background="{StaticResource BrushAccent}"
                                    HorizontalAlignment="Left">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="LoadingTx"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="LoadingTx"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="0" To="26" Duration="0:0:0.8"
                                                                 AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Border>
                        <TextBlock Text="로딩 중" Style="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

        </Grid>

        <!-- Toast OSD는 owned ToastWindow(별도 hwnd)로 띄움 — WPF airspace 우회.
             code-behind OnWindowLoaded에서 생성. -->


        <!-- ============================================================
             BOTTOM CONTROLS — transport
             ============================================================ -->
        <Border Grid.Row="2"
                x:Name="BottomBar"
                Background="{StaticResource BrushBgRaised}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,6,14,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0: SeekBar -->
                    <RowDefinition Height="Auto"/>  <!-- 1: 컨트롤 -->
                    <RowDefinition Height="Auto"/>  <!-- 2: 편집 모드 hint (편집 모드일 때만 행 차지) -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TimePosDisplay}"
                               Style="{StaticResource TextMono}"
                               VerticalAlignment="Center" MinWidth="56"/>
                    <Grid Grid.Column="1" Margin="10,0">
                        <Slider x:Name="SeekBar"
                                Style="{StaticResource SeekSlider}"
                                Minimum="0"
                                Maximum="{Binding Duration}"
                                Value="{Binding TimePos, Mode=OneWay}"
                                IsEnabled="{Binding HasMedia}"
                                PreviewMouseLeftButtonDown="OnSeekDown"
                                PreviewMouseMove="OnSeekMove"
                                PreviewMouseLeftButtonUp="OnSeekUp"
                                MouseWheel="OnSeekWheel"/>
                        <!-- 편집 모드 overlay: IN/OUT 핸들 + 강조 -->
                        <Canvas x:Name="TrimOverlay" IsHitTestVisible="True"
                                Visibility="{Binding IsTrimMode, Converter={StaticResource BoolVis}}">
                            <!-- IN-OUT 사이 강조 (accent 반투명) -->
                            <Rectangle x:Name="TrimRangeFill"
                                       Height="8" Fill="#5557E389"
                                       Canvas.Top="0" IsHitTestVisible="False"/>
                            <!-- IN 핸들 -->
                            <Thumb x:Name="TrimInThumb" Width="12" Height="22"
                                   Background="{StaticResource BrushAccent}"
                                   BorderBrush="#FF000000" BorderThickness="1"
                                   Cursor="SizeWE" Canvas.Top="-6"
                                   DragDelta="OnTrimInDrag"
                                   ToolTip="IN 지점 — 드래그로 조정">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <!-- OUT 핸들 -->
                            <Thumb x:Name="TrimOutThumb" Width="12" Height="22"
                                   Background="{StaticResource BrushAccent}"
                                   BorderBrush="#FF000000" BorderThickness="1"
                                   Cursor="SizeWE" Canvas.Top="-6"
                                   DragDelta="OnTrimOutDrag"
                                   ToolTip="OUT 지점 — 드래그로 조정">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Canvas>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}"
                               Style="{StaticResource TextMono}"
                               VerticalAlignment="Center" MinWidth="56" TextAlignment="Right"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}"
                                Content="&#xE892;"
                                ToolTip="이전 파일 (PageUp / Ctrl+←)"
                                Command="{Binding PrevCommand}"/>
                        <Button Style="{StaticResource PrimaryIconButton}"
                                Content="{Binding IsPaused, Converter={StaticResource PlayIcon}}"
                                ToolTip="재생/일시정지 (Space)"
                                Command="{Binding PlayPauseCommand}"
                                Margin="2,0"/>
                        <Button Style="{StaticResource IconButton}"
                                Content="&#xE893;"
                                ToolTip="다음 파일 (PageDown / Ctrl+→)"
                                Command="{Binding NextCommand}"/>
                        <Border Width="1" Height="18"
                                Background="{StaticResource BrushBorderStrong}" Margin="6,0"/>
                        <!-- 3개 mutex 버튼 — 한 번 click이면 그 mode로 즉시 set, cycle 안 함 -->
                        <Button Style="{StaticResource RepeatNoneButton}"
                                Content="&#xE71A;"
                                ToolTip="반복 안 함 (전체 한 번 끝나면 멈춤)"
                                Command="{Binding SetRepeatNoneCommand}"/>
                        <Button Style="{StaticResource RepeatAllButton}"
                                Content="&#xE8EE;"
                                ToolTip="전체 반복 (마지막 곡 끝나면 처음으로)"
                                Command="{Binding SetRepeatAllCommand}"/>
                        <Button Style="{StaticResource RepeatOneButton}"
                                Content="&#xE8ED;"
                                ToolTip="한 곡 반복 (현재 곡만 계속)"
                                Command="{Binding SetRepeatOneCommand}"/>
                        <Button Style="{StaticResource ShuffleToggleButton}"
                                Content="&#xE8B1;"
                                Command="{Binding ToggleShuffleCommand}"
                                Click="OnTooltipRefreshClick"
                                MouseLeave="OnTooltipMouseLeave"
                                ToolTipService.InitialShowDelay="0"
                                ToolTipService.BetweenShowDelay="0"
                                ToolTipService.ShowDuration="2500"
                                ToolTipService.Placement="Top">
                            <Button.ToolTip>
                                <ToolTip Content="{Binding ShuffleTooltip}"/>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}"
                                Content="{Binding IsMuted, Converter={StaticResource MuteIcon}}"
                                ToolTip="음소거 (M)"
                                Command="{Binding MuteCommand}"/>
                        <Slider Style="{StaticResource VolumeSlider}"
                                Value="{Binding Volume}"
                                VerticalAlignment="Center"
                                Margin="4,0,8,0"
                                PreviewMouseLeftButtonDown="OnVolumeSliderDown"
                                PreviewMouseMove="OnVolumeSliderMove"
                                PreviewMouseLeftButtonUp="OnVolumeSliderUp"/>

                        <Border Width="1" Height="18"
                                Background="{StaticResource BrushBorderStrong}" Margin="4,0"/>

                        <Button x:Name="SpeedButton"
                                Style="{StaticResource GhostButton}"
                                Content="{Binding SpeedDisplay}"
                                ToolTip="배속 — 클릭=프리셋 메뉴, 휠=±0.25, Shift+./, =±0.25"
                                Click="OnSpeedButtonClick"
                                MouseWheel="OnSpeedWheel"
                                MinWidth="56"
                                Margin="2,0">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="SpeedMenu" Placement="Top">
                                    <MenuItem Header="0.25x" Command="{Binding SetSpeedCommand}" CommandParameter="0.25"/>
                                    <MenuItem Header="0.5x"  Command="{Binding SetSpeedCommand}" CommandParameter="0.5"/>
                                    <MenuItem Header="0.75x" Command="{Binding SetSpeedCommand}" CommandParameter="0.75"/>
                                    <MenuItem Header="1.0x ─ 기본" Command="{Binding SetSpeedCommand}" CommandParameter="1.0"/>
                                    <MenuItem Header="1.25x" Command="{Binding SetSpeedCommand}" CommandParameter="1.25"/>
                                    <MenuItem Header="1.5x"  Command="{Binding SetSpeedCommand}" CommandParameter="1.5"/>
                                    <MenuItem Header="1.75x" Command="{Binding SetSpeedCommand}" CommandParameter="1.75"/>
                                    <MenuItem Header="2.0x"  Command="{Binding SetSpeedCommand}" CommandParameter="2.0"/>
                                    <Separator/>
                                    <MenuItem Header="3.0x"  Command="{Binding SetSpeedCommand}" CommandParameter="3.0"/>
                                    <MenuItem Header="4.0x"  Command="{Binding SetSpeedCommand}" CommandParameter="4.0"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Border Width="1" Height="18"
                                Background="{StaticResource BrushBorderStrong}" Margin="4,0"/>

                        <Button Style="{StaticResource IconButton}"
                                Content="{Binding IsFullscreen, Converter={StaticResource FsIcon}}"
                                ToolTip="전체화면 (F)"
                                Command="{Binding FullscreenCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- 편집 모드 hint — 사용자가 다음 동작 명확히 알게. 편집 모드일 때만 행 차지. -->
                <Border Grid.Row="2" Margin="0,6,0,0"
                        Background="#1A57E389"
                        BorderBrush="{StaticResource BrushAccent}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}"
                        Padding="10,4"
                        Visibility="{Binding IsTrimMode, Converter={StaticResource BoolVis}}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource BrushAccent}">
                        <Run Text="✂ 편집 중 — "/>
                        <Run Text="{Binding TrimRangeDisplay, Mode=OneWay}"/>
                        <Run Text="  ·  양쪽 핸들 드래그로 IN/OUT 조정 → 우측 상단 "/>
                        <Run Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                        <Run Text=" 저장"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
