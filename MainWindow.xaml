<Window x:Class="DenoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:h="clr-namespace:DenoPlayer.Helpers"
        xmlns:vm="clr-namespace:DenoPlayer.ViewModels"
        Title="Deno Player"
        MinWidth="640" MinHeight="380"
        Width="1280" Height="760"
        Background="{StaticResource BrushBgBase}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        Focusable="True"
        ResizeMode="CanResize"
        MouseDoubleClick="OnRootDoubleClick"
        FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolVis"/>
        <h:BoolToVisibilityConverter x:Key="BoolVisHidden" WhenFalse="Hidden"/>
        <h:BoolToVisibilityConverter x:Key="BoolVisInverse" Invert="True"/>
        <h:PlayPauseIconConverter x:Key="PlayIcon"/>
        <h:MuteIconConverter x:Key="MuteIcon"/>
        <h:FullscreenIconConverter x:Key="FsIcon"/>
        <h:StateToVisibilityConverter x:Key="ShowOnNoFile" Show="NoFile"/>
        <h:StateToVisibilityConverter x:Key="ShowOnFailed" Show="Failed"/>
        <h:StateToVisibilityConverter x:Key="ShowOnLoading" Show="Loading"/>
        <h:StateToVisibilityConverter x:Key="ShowOnDragging" Show="Dragging"/>

        <!-- AlwaysOnTop toggle 버튼: IsAlwaysOnTop true면 accent foreground -->
        <Style x:Key="PinButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlwaysOnTop}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="28"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Space"    Command="{Binding PlayPauseCommand}"/>
        <KeyBinding Key="M"        Command="{Binding MuteCommand}"/>
        <KeyBinding Key="F"        Command="{Binding FullscreenCommand}"/>
        <KeyBinding Key="F11"      Command="{Binding FullscreenCommand}"/>
        <KeyBinding Key="Enter"    Modifiers="Alt" Command="{Binding FullscreenCommand}"/>
        <KeyBinding Key="Left"     Command="{Binding Seek5BackwardCommand}"/>
        <KeyBinding Key="Right"    Command="{Binding Seek5ForwardCommand}"/>
        <KeyBinding Key="Left"     Modifiers="Shift" Command="{Binding Seek30BackwardCommand}"/>
        <KeyBinding Key="Right"    Modifiers="Shift" Command="{Binding Seek30ForwardCommand}"/>
        <KeyBinding Key="Up"       Command="{Binding VolumeUpCommand}"/>
        <KeyBinding Key="Down"     Command="{Binding VolumeDownCommand}"/>
        <KeyBinding Key="PageUp"   Command="{Binding PrevCommand}"/>
        <KeyBinding Key="PageDown" Command="{Binding NextCommand}"/>
        <KeyBinding Key="OemPeriod" Modifiers="Shift" Command="{Binding IncreaseSpeedCommand}"/>
        <KeyBinding Key="OemComma"  Modifiers="Shift" Command="{Binding DecreaseSpeedCommand}"/>
        <KeyBinding Key="OemPeriod" Command="{Binding FrameStepCommand}"/>
        <KeyBinding Key="OemComma"  Command="{Binding FrameBackCommand}"/>
        <KeyBinding Key="O"        Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S"        Modifiers="Control" Command="{Binding ScreenshotCommand}"/>
        <KeyBinding Key="T"        Modifiers="Control" Command="{Binding AlwaysOnTopCommand}"/>
    </Window.InputBindings>

    <Grid x:Name="Root"
          MouseMove="OnRootMouseMove"
          MouseLeave="OnRootMouseLeave"
          PreviewMouseDown="OnRootPreviewMouseDown"
          MouseWheel="OnRootMouseWheel"
          Background="{StaticResource BrushBgBase}">

        <!-- 영상 호스트 (전체) — child Win32 window. mpv가 이 hwnd 안에 그림. -->
        <Border x:Name="VideoHostContainer"
                Background="#FF050705"
                Focusable="False">
            <ContentControl x:Name="VideoHostSlot" Focusable="False"/>
        </Border>

        <!-- 우측 끝 hot zone -->
        <Border x:Name="PlaylistHotZone"
                Width="{StaticResource PlaylistHotZoneWidth}"
                HorizontalAlignment="Right"
                Background="Transparent"
                MouseEnter="OnHotZoneEnter"/>

        <!-- ============================================================
             상태별 오버레이
             ============================================================ -->

        <!-- NoFile -->
        <Grid Visibility="{Binding State, Converter={StaticResource ShowOnNoFile}}"
              Background="#FF0B0E0C"
              ClipToBounds="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <Border BorderBrush="{StaticResource BrushBorderStrong}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="40,28"
                        Background="{StaticResource BrushBgRaised}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{StaticResource BrushAccent}"
                                Margin="0,0,0,14" HorizontalAlignment="Center"/>
                        <TextBlock Text="DENO PLAYER"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushFgMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,18"/>
                        <TextBlock Text="미디어를 끌어다 놓으세요"
                                   Style="{StaticResource TextBody}"
                                   FontSize="{StaticResource FontSizeLg}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="또는 Ctrl+O / 더블클릭으로 열기"
                                   Style="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,18"/>
                        <Button Content="파일 열기"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding OpenCommand}"
                                HorizontalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Border>
                <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0"
                           Style="{StaticResource TextMono}"
                           Text=".mp4 .mkv .mov .webm  ·  .mp3 .flac .wav  ·  .png .jpg .gif"/>
            </StackPanel>
        </Grid>

        <!-- Failed -->
        <Grid Visibility="{Binding State, Converter={StaticResource ShowOnFailed}}"
              Background="#CC0B0E0C">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
                <TextBlock Text="재생할 수 없습니다"
                           Style="{StaticResource TextBody}"
                           FontSize="{StaticResource FontSizeLg}"
                           Foreground="{StaticResource BrushDanger}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource TextMuted}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="다른 파일 열기"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding OpenCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="다음 파일" Style="{StaticResource GhostButton}"
                            Command="{Binding NextCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Loading -->
        <Grid Visibility="{Binding State, Converter={StaticResource ShowOnLoading}}"
              Background="#AA0B0E0C">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="40" Height="2" Background="{StaticResource BrushBorderStrong}" Margin="0,0,0,10">
                    <Border Width="14" Height="2"
                            Background="{StaticResource BrushAccent}"
                            HorizontalAlignment="Left">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="LoadingTx"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="LoadingTx"
                                                         Storyboard.TargetProperty="X"
                                                         From="0" To="26" Duration="0:0:0.8"
                                                         AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </Border>
                <TextBlock Text="로딩 중" Style="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Dragging — drop target highlight -->
        <Border Visibility="{Binding State, Converter={StaticResource ShowOnDragging}}"
                BorderBrush="{StaticResource BrushAccent}"
                BorderThickness="2"
                Background="#1457E389"
                IsHitTestVisible="False"/>

        <!-- ============================================================
             TOP BAR
             ============================================================ -->
        <Border x:Name="TopBar"
                VerticalAlignment="Top"
                Height="36"
                Background="{StaticResource BrushBgOverlay}"
                Effect="{StaticResource ShadowControlBar}"
                Opacity="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0">
                    <Ellipse Width="6" Height="6"
                             Fill="{StaticResource BrushAccent}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             Visibility="{Binding HasMedia, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding FileNameDisplay, FallbackValue=''}"
                               Style="{StaticResource TextBody}"
                               FontSize="{StaticResource FontSizeSm}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="640"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource PinButton}"
                            Content=""
                            ToolTip="항상 위 (Ctrl+T)"
                            Command="{Binding AlwaysOnTopCommand}"/>
                    <Button Style="{StaticResource IconButton}"
                            Content=""
                            ToolTip="스크린샷 (Ctrl+S)"
                            Command="{Binding ScreenshotCommand}"/>
                    <Button Style="{StaticResource IconButton}"
                            Content=""
                            ToolTip="파일 열기 (Ctrl+O)"
                            Command="{Binding OpenCommand}"/>
                    <Border Width="1" Height="16" Background="{StaticResource BrushBorderStrong}" Margin="6,0"/>
                    <Button Style="{StaticResource IconButton}" Content="" ToolTip="최소화" Click="OnMinimize"/>
                    <Button x:Name="MaxRestoreBtn" Style="{StaticResource IconButton}"
                            Content="" ToolTip="최대화/복원" Click="OnMaxRestore"/>
                    <Button Style="{StaticResource IconButton}" Content="" ToolTip="닫기" Click="OnClose"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             BOTTOM CONTROLS
             ============================================================ -->
        <Border x:Name="BottomBar"
                VerticalAlignment="Bottom"
                Background="{StaticResource BrushBgOverlay}"
                Effect="{StaticResource ShadowControlBar}"
                Opacity="0"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid Margin="14,6,14,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TimePosDisplay}"
                               Style="{StaticResource TextMono}"
                               VerticalAlignment="Center" MinWidth="56"/>
                    <Slider Grid.Column="1"
                            x:Name="SeekBar"
                            Style="{StaticResource SeekSlider}"
                            Minimum="0"
                            Maximum="{Binding Duration}"
                            Value="{Binding TimePos, Mode=OneWay}"
                            IsEnabled="{Binding HasMedia}"
                            Margin="10,0"
                            PreviewMouseLeftButtonDown="OnSeekDown"
                            PreviewMouseLeftButtonUp="OnSeekUp"
                            MouseWheel="OnSeekWheel"/>
                    <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}"
                               Style="{StaticResource TextMono}"
                               VerticalAlignment="Center" MinWidth="56" TextAlignment="Right"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}"
                                Content=""
                                ToolTip="이전 파일 (PageUp)"
                                Command="{Binding PrevCommand}"/>
                        <Button Style="{StaticResource PrimaryIconButton}"
                                Content="{Binding IsPaused, Converter={StaticResource PlayIcon}}"
                                ToolTip="재생/일시정지 (Space)"
                                Command="{Binding PlayPauseCommand}"
                                Margin="2,0"/>
                        <Button Style="{StaticResource IconButton}"
                                Content=""
                                ToolTip="다음 파일 (PageDown)"
                                Command="{Binding NextCommand}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}"
                                Content="{Binding IsMuted, Converter={StaticResource MuteIcon}}"
                                ToolTip="음소거 (M)"
                                Command="{Binding MuteCommand}"/>
                        <Slider Style="{StaticResource VolumeSlider}"
                                Value="{Binding Volume}"
                                VerticalAlignment="Center"
                                Margin="4,0,8,0"/>

                        <Border Width="1" Height="18"
                                Background="{StaticResource BrushBorderStrong}" Margin="4,0"/>

                        <Button Style="{StaticResource GhostButton}"
                                Content="{Binding SpeedDisplay}"
                                Command="{Binding ResetSpeedCommand}"
                                ToolTip="배속 (Shift+. / Shift+, — 클릭=1.0x, 휠 가능)"
                                MouseWheel="OnSpeedWheel"
                                MinWidth="50"
                                Margin="2,0"/>

                        <Border Width="1" Height="18"
                                Background="{StaticResource BrushBorderStrong}" Margin="4,0"/>

                        <Button Style="{StaticResource IconButton}"
                                Content="{Binding IsFullscreen, Converter={StaticResource FsIcon}}"
                                ToolTip="전체화면 (F)"
                                Command="{Binding FullscreenCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================================
             PLAYLIST PANEL
             ============================================================ -->
        <Border x:Name="PlaylistPanel"
                Width="{StaticResource PlaylistDefaultWidth}"
                HorizontalAlignment="Right"
                Background="{StaticResource BrushBgRaised}"
                BorderBrush="{StaticResource BrushBorderStrong}"
                BorderThickness="1,0,0,0"
                Effect="{StaticResource ShadowPanel}"
                Opacity="0"
                IsHitTestVisible="False"
                MouseEnter="OnPlaylistEnter"
                MouseLeave="OnPlaylistLeave"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PlaylistTx" X="320"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="14,12" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="현재 폴더" Style="{StaticResource TextMono}"/>
                        <TextBlock Text="{Binding FolderDisplay}"
                                   Style="{StaticResource TextBody}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="1"
                         x:Name="PlaylistListBox"
                         Style="{StaticResource PlaylistList}"
                         ItemsSource="{Binding Playlist}"
                         SelectedItem="{Binding CurrentMedia, Mode=OneWay}"
                         MouseDoubleClick="OnPlaylistDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FileName}"
                                               Style="{StaticResource TextBody}"
                                               FontSize="{StaticResource FontSizeSm}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource TextMono}"
                                               Text="실패"
                                               Foreground="{StaticResource BrushDanger}"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DurationDisplay}"
                                           Style="{StaticResource TextMono}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Padding="14,8" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
                    <TextBlock Style="{StaticResource TextMono}">
                        <Run Text="{Binding Playlist.Count, Mode=OneWay}"/>
                        <Run Text=" 항목"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
